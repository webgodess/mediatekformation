{% extends "baseback.html.twig" %}
{% block body %}
<table class="table table-striped">
    <caption>Liste des 
Catégories</caption>
        <thead>
            <tr>
                
                <th class="text-left align-top" scope="col">
                   &nbsp;          
                </th>
                <th class="text-center align-top" scope="col">
                    <br />
                    &nbsp;
                </th>
                <th class="text-center align-top" scope="col">
                &nbsp;
                </th>
                <th class="text-center align-top" scope="col">
                    &nbsp;
                </th>
                <th class="text-center align-top" scope="col">
            <form action="{{ path('admin.categories.add') }}" method="post" style="display: inline;">
                <label for="cname">Category Name: </label>
                <input type="text" id="cname" name="name">
                <input type="hidden" name="token" value="{{ csrf_token('add-categorie') }}">
                         <button class="btn btn-success" type="submit" value="Submit"><i class="fas fa-plus"></i></button>
                         </form>
        
                </th>
            </tr>
        </thead>
          <tbody>
            {% for categorie in categories %}
                <tr class="align-middle">
                    <td>
                        <h5 class="text-info">{{ categorie.name }}</h5>
                    </td>
                    <td class="text-center">
                        <form action="{{ path('admin.categories.remove', {id: categorie.id}) }}" method="post" style="display: inline;">
                            <input type="hidden" name="token" value="{{ csrf_token('delete-categorie') }}">
                            <button class="btn btn-danger btn-sm" type="submit" 
                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer « {{ categorie.name }} » ?')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}